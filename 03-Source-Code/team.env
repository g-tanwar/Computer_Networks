# Team 1 lab addresses. No passwords or private keys.
# Wi-Fi (DHCP) hands out new addresses. Check them at the start of every lab day:
#   ipconfig getifaddr en0
# and update the four *_IP lines below. Every script reads this file.
# Last checked: 26 Nov 2026 (Phase 2 session).
TEAM_NAME="Team 1"
DOMAIN=team1.test
APP_HOST=app.team1.test
API_HOST=api.team1.test

# Machine addresses
MAC1_IP=10.7.11.104   # Piyush - DNS (primary) + Backend B
MAC2_IP=10.7.1.118    # Gourav - edge nginx (primary)
MAC3_IP=10.7.15.147   # Alok   - Backend A + client + Wireshark
MAC4_IP=10.7.31.120   # Ashar  - DNS (backup) + edge nginx (standby) + client

# Roles, derived from the addresses above
DNS_IP=${MAC1_IP}
BACKUP_DNS_IP=${MAC4_IP}
EDGE_IP=${MAC2_IP}
STANDBY_EDGE_IP=${MAC4_IP}
BACKEND_A_IP=${MAC3_IP}
BACKEND_A_PORT=3001
BACKEND_B_IP=${MAC1_IP}
BACKEND_B_PORT=3002

# Unused address for the "wrong DNS record" failure test. Ping it first: it must not reply.
WRONG_IP=10.7.31.250

GATEWAY=10.7.0.1
PREFIX=19
NETMASK=255.255.224.0
IFACE=en0

MAC1_PERSON=Piyush
MAC2_PERSON=Gourav
MAC3_PERSON=Alok
MAC4_PERSON="Ashar Shaikh"
MAC4_USER=ashar
MAC1_MAC=10:9f:41:c0:9e:e5
MAC2_MAC=e6:09:91:27:22:3b
MAC3_MAC=72:36:67:c5:54:98

CA_CN="Team1 Local CA"
CERT_DIR="${HOME}/cn-certs"
HTTPS_PORT=443
DNS_TTL=60
